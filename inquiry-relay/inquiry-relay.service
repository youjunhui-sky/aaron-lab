[Unit]
Description=inquiry-relay — form -> anti-spam -> IM push
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

# env: .env is read by the app (pydantic-settings); harden a bit
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__INSTALL_DIR__/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
