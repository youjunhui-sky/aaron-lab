# inquiry-relay configuration
# copy to .env and fill in; .env is gitignored — never commit real values
# every INQUIRY_* var below is optional; defaults shown as comments

# --- server ---
# INQUIRY_HOST=0.0.0.0
# INQUIRY_PORT=8000

# --- storage ---
# SQLite file path (created automatically)
# INQUIRY_DB_PATH=data/inquiries.db

# --- anti-spam layer 1: honeypot ---
# incoming field that must stay empty; filled => silently rejected (202 to fool bots)
# INQUIRY_HONEYPOT_FIELD=website

# --- anti-spam layer 2: rate limit (per IP and per email) ---
# INQUIRY_RATE_LIMIT_MAX=5
# INQUIRY_RATE_LIMIT_WINDOW_SECONDS=60

# --- anti-spam layer 3: Cloudflare Turnstile ---
# empty secret = disabled; set to enable server-side verification
# INQUIRY_TURNSTILE_SECRET_KEY=

# --- dedupe (same email + message inside window => duplicate, no re-push) ---
# INQUIRY_DEDUPE_WINDOW_SECONDS=86400

# --- field mapping (canonical -> incoming field names) ---
# JSON object; unmapped keys keep canonical names
# INQUIRY_FIELD_MAP={"email":"mail","message":"body"}

# --- IM push (D3) ---
# feishu custom bot webhook URL (preferred)
# FEISHU_WEBHOOK_URL=
# telegram bot push
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
