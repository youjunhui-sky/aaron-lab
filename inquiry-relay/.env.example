# inquiry-relay configuration
# copy to .env and fill in; .env is gitignored — never commit real values

# --- server ---
# INQUIRY_HOST=0.0.0.0
# INQUIRY_PORT=8000

# --- storage ---
# SQLite file path (created automatically)
# INQUIRY_DB_PATH=data/inquiries.db

# --- anti-spam (D2) ---
# Cloudflare Turnstile: empty secret = verification disabled
# TURNSTILE_SECRET_KEY=
# honeypot field name clients must leave empty
# HONEYPOT_FIELD=website
# rate limit: max submissions per window, per IP and per email
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_SECONDS=60

# --- IM push (D3) ---
# feishu custom bot webhook URL (preferred)
# FEISHU_WEBHOOK_URL=
# telegram bot push
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
